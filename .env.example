# Copy to .env for local overrides. Every variable here has a working default in configs/,
# so `make dev` runs with none of them set.

# HTTP
HTTP_ADDR=:8000
REQUEST_TIMEOUT=3s

# Upstreams (A5 - two separate mock servers)
SALES_BASE_URL=http://localhost:9100
SERVICE_BASE_URL=http://localhost:9101
PER_SOURCE_TIMEOUT=2s
AGGREGATE_TIMEOUT=2500ms

# Database (A8 - matches deployments/docker/docker-compose.infra.yaml)
DATABASE_URL=postgres://viewer:viewer@localhost:5432/viewer?sslmode=disable
DB_MAX_CONNS=10
CACHE_TTL=60s

# Observability
LOG_LEVEL=info

# Salt for hashing VINs before they reach logs, traces or the audit table.
# Development default only - a real deployment must supply its own and never log it.
VIN_HASH_SALT=dev-only-not-a-secret
